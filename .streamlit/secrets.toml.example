# このファイルをsecrets.tomlにコピーして実値に置き換えます。
# 実際のsecrets.tomlや認証JSONはGitHubに登録しないでください。
GEMINI_API_KEY = "REMOVED_GEMINI_API_KEY"
SPREADSHEET_KEY = "1Zb5bONn97V1Pbo_kaTP-PPHdGiXPHNVJdYNyK7XRXP4"
# 空欄なら先頭のワークシートを読み込みます。
WORKSHEET_NAME = ""

# Cloudでは認証JSONの対応する値を以下に転記します。
# ローカルの認証JSONを使う場合、このテーブル全体を削除してください。
[gcp_service_account]
type = "service_account"
project_id = "YOUR_PROJECT_ID"
private_key_id = "YOUR_PRIVATE_KEY_ID"
private_key = """-----BEGIN PRIVATE KEY-----
YOUR_PRIVATE_KEY
-----END PRIVATE KEY-----
"""
client_email = "YOUR_SERVICE_ACCOUNT_EMAIL"
client_id = "YOUR_CLIENT_ID"
token_uri = "https://oauth2.googleapis.com/token"
